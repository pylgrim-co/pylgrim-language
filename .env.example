# pylgrim — configuration
#
# Copy to .env.local. Only ANTHROPIC_API_KEY is required; without the
# Azure keys, audio degrades with a clear message rather than breaking.
#
# .env.local is gitignored. Never commit real values.

# ---------------------------------------------------------------------------
# Generation — required
# ---------------------------------------------------------------------------

# Your own Anthropic key. Requests are billed to your account; pylgrim is
# not in the loop. https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-api03-...

# ---------------------------------------------------------------------------
# Audio — optional (Azure Speech)
# ---------------------------------------------------------------------------

# Key plus ONE of endpoint or region.
#AZURE_SPEECH_KEY=
#AZURE_SPEECH_ENDPOINT=https://your-resource.cognitiveservices.azure.com
#AZURE_SPEECH_REGION=westeurope

# ---------------------------------------------------------------------------
# Development only
# ---------------------------------------------------------------------------

# Generate through a local Claude Code subscription login instead of an API
# key. A subscription is personal auth, not a service credential — never
# use this for anything you expose.
#PYLGRIM_PROVIDER=claude-code
